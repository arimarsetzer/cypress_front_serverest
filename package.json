{
  "name": "cypress_front_serverest",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress E2E and API test suite for the ServeRest demo store",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "cypress run --browser chrome",
    "test:ui": "cypress run --browser chrome --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:api": "cypress run --browser chrome --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:headed": "cypress run --browser chrome --headed",
    "cy:open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^16.1.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.12.0",
    "mocha-junit-reporter": "^2.2.1",
    "prettier": "3.9.9"
  }
}
